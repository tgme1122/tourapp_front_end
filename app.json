{
  "expo": {
    "name": "Sayohat",
    "slug": "sayohatapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon copy.png",
    "scheme": "sayohatapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon copy.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D4502F",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon copy.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D4502F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Ovozli xabar yozish uchun mikrofonga ruxsat bering."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
